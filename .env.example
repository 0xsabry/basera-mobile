EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback name (still honored): EXPO_PUBLIC_SUPABASE_ANON_KEY=
# CI/EAS only (store in EAS env vars / GitHub Secrets, never in the bundle):
# EXPO_TOKEN=
